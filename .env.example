# Supabase Public Configuration (safe for client-side Vite bundle)
# Use the project API origin, not the management dashboard URL.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# IMPORTANT:
# Never put SUPABASE_SERVICE_ROLE_KEY in VITE_* variables or commit .env files to GitHub.
# Backend order creation, inventory locking, and 10% email discount validation run securely
# inside Supabase PostgreSQL RPC functions (see supabase/migrations/007_cod_checkout.sql).

# --- Transactional emails (Resend) ---
# These are server-side Vercel environment variables. Set them in the Vercel
# project settings, never in this file with real values, and never in VITE_*
# variables that would ship them to the browser.
# RESEND_API_KEY=re_123...        # from Resend dashboard (required before emails are sent)
# FROM_EMAIL=orders@yourdomain.com  # verified sender address in Resend (default below is for tests only)
# SUPABASE_URL=https://your-project-id.supabase.co   # server-side Supabase client for email dispatch
# SUPABASE_SERVICE_ROLE_KEY=...   # server-only, bypasses RLS to write the delivery log
# PUBLIC_SITE_URL=https://three-ways-studios.vercel.app  # absolute links used inside emails
# ADMIN_NOTIFICATION_EMAIL=zizo3bro@gmail.com  # new-order notification recipient
