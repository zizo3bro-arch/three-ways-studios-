# Supabase Public Configuration (safe for client-side Vite bundle)
# Use the project API origin, not the management dashboard URL.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# IMPORTANT:
# Never put SUPABASE_SERVICE_ROLE_KEY in VITE_* variables or commit .env files to GitHub.
# Backend order creation, inventory locking, and 10% email discount validation run securely
# inside Supabase PostgreSQL RPC functions (see supabase/migrations/007_cod_checkout.sql).

# --- Server-only email notification functions (set in Vercel, NEVER in the client) ---
# Required for api/order-confirmation and api/admin-new-order. These are read by
# the serverless functions, never bundled into the frontend. No VITE_ prefix.
# Supabase project URL + service role key (service role bypasses RLS; keep out of VITE_*):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Resend (https://resend.com): full sending-capable API key + sender identity.
RESEND_API_KEY=re_your_sending_key
RESEND_FROM_EMAIL=Three Ways Studios <orders@your-verified-domain.com>
# Studio notification inbox for admin-new-order (server-configured only):
ADMIN_NOTIFICATION_EMAIL=studio-orders@your-verified-domain.com
# Optional tuning (safe defaults; must be valid for the endpoint to start):
# EMAIL_CLAIM_LEASE_SECONDS=120        (min 30: claim lease, see docs/email-system.md)
# EMAIL_IP_LIMIT=20                    (per-IP, per-endpoint, per window)
# EMAIL_IP_WINDOW_SECONDS=600
# EMAIL_ORDER_LIMIT=5                  (per-order)
# EMAIL_ORDER_WINDOW_SECONDS=3600
